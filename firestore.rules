rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private email index: only Alex can read or write anything.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'octopus0246@gmail.com';
    }
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
